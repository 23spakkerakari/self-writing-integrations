{
  "name": "carto-web",
  "version": "0.2.0",
  "private": true,
  "description": "carto console (spec section 13): Map > Review and the read-only inventory screens",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.15 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build && node scripts/check-build.mjs",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --mode e2e --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build:e2e && playwright test",
    "e2e:install": "playwright install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fonts": "node scripts/copy-fonts.mjs",
    "gen:api": "openapi-typescript ../core/openapi/openapi.v1.json -o src/api/generated.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-radio-group": "1.5.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-visually-hidden": "1.2.13",
    "@tanstack/react-query": "5.104.4",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-sans-condensed": "2.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
