{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":pinDevDependencies"
  ],
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "ignorePaths": ["legacy/**"],
  "packageRules": [
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    }
  ]
}
